{
  "entities": {
    "Lote": {
      "title": "Lote",
      "description": "Lote de semillas procesadas o en proceso en planta",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "especie": { "type": "string" },
        "variedad": { "type": "string" },
        "numeroLote": { "type": "string" },
        "cliente": { "type": "string" },
        "tipoLote": { "type": "string" },
        "categoria": { "type": "string" },
        "stockBolsas": { "type": "number" },
        "kgPorBolsa": { "type": "number" },
        "stockKgTotal": { "type": "number" },
        "estado": { "type": "string" },
        "fechaIngreso": { "type": "string" }
      },
      "required": ["id", "especie", "cliente", "numeroLote"]
    },
    "SilosEstado": {
      "title": "SilosEstado",
      "description": "Estado operativo manual de los 6 silos físicos (OCUPADO, VACIO_SUCIO, VACIO_LIMPIO)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "estados": { "type": "object" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id"]
    },
    "MovimientoSilo": {
      "title": "MovimientoSilo",
      "description": "Registro de ingreso o egreso de stock en silos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siloId": { "type": "string" },
        "fecha": { "type": "string" },
        "hora": { "type": "string" },
        "tipo": { "type": "string" },
        "kg": { "type": "number" },
        "cliente": { "type": "string" },
        "variedad": { "type": "string" },
        "especie": { "type": "string" },
        "bolsonOrigenNro": { "type": "string" },
        "depositoOrigen": { "type": "string" },
        "humedad": { "type": "number" },
        "observaciones": { "type": "string" }
      },
      "required": ["id", "siloId", "fecha", "tipo", "kg"]
    },
    "BolsonCampo": {
      "title": "BolsonCampo",
      "description": "Gestión agronómica de silobolsas y almacenamiento en campo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numeroBolson": { "type": "string" },
        "cliente": { "type": "string" },
        "cultivo": { "type": "string" },
        "variedad": { "type": "string" },
        "campo": { "type": "string" },
        "zona": { "type": "string" },
        "tipoBolsa": { "type": "string" },
        "capacidadTn": { "type": "number" },
        "humedad": { "type": "number" },
        "rendimiento": { "type": "number" },
        "superficieHa": { "type": "number" },
        "coordenadasGis": { "type": "string" },
        "entradasKg": { "type": "number" },
        "salidasKg": { "type": "number" },
        "stockKg": { "type": "number" },
        "categoria": { "type": "string" },
        "material": { "type": "string" }
      },
      "required": ["id", "numeroBolson", "cliente", "cultivo"]
    },
    "PlantaCatalogos": {
      "title": "PlantaCatalogos",
      "description": "Listas maestras de planta: clientes, especies, variedades, tipos, categorias y tratamientos",
      "type": "object",
      "properties": {
        "clientes": { "type": "array" },
        "especies": { "type": "array" },
        "variedades": { "type": "array" },
        "tipos": { "type": "array" },
        "categorias": { "type": "array" },
        "tratamientos": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "TurnoParking": {
      "title": "TurnoParking",
      "description": "Registro de turnos solicitados en Parking con precarga anexada",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string" },
        "franja": { "type": "string" },
        "horario": { "type": "string" },
        "cliente": { "type": "string" },
        "despachante": { "type": "string" },
        "estado": { "type": "string" },
        "ordenCargaId": { "type": "string" },
        "precarga": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "fecha", "horario", "cliente", "despachante", "estado"]
    },
    "ParkingConfig": {
      "title": "ParkingConfig",
      "description": "Configuración de horarios de Parking y turnos bloqueados",
      "type": "object",
      "properties": {
        "horariosManana": { "type": "array" },
        "horariosTarde": { "type": "array" },
        "turnosBloqueadosGlobal": { "type": "object" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "Movimiento": {
      "title": "Movimiento",
      "description": "Registro de cambios de estado, transformaciones y contraasientos de lote",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loteId": { "type": "string" },
        "fecha": { "type": "string" },
        "usuario": { "type": "string" },
        "tipo": { "type": "string" },
        "valorAnterior": { "type": "string" },
        "valorNuevo": { "type": "string" },
        "observaciones": { "type": "string" }
      },
      "required": ["id", "loteId", "fecha", "usuario", "tipo"]
    },
    "ReporteDiario": {
      "title": "ReporteDiario",
      "description": "Carga diaria de kilos producidos y kilos curados contra un lote específico",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string" },
        "tipo": { "type": "string" },
        "kg": { "type": "number" },
        "loteId": { "type": "string" },
        "usuario": { "type": "string" }
      },
      "required": ["id", "fecha", "tipo", "kg", "loteId", "usuario"]
    },
    "Bolsa": {
      "title": "Bolsa",
      "description": "Identificación unitaria correlativa de bolsas con código QR y trazabilidad",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loteId": { "type": "string" },
        "numero": { "type": "number" },
        "totalBolsas": { "type": "number" },
        "kg": { "type": "number" },
        "estado": { "type": "string" },
        "bolsaOrigenId": { "type": "string" },
        "caratulaId": { "type": "string" }
      },
      "required": ["id", "loteId", "numero", "totalBolsas", "kg", "estado", "caratulaId"]
    },
    "Caratula": {
      "title": "Caratula",
      "description": "Carátula oficial emitida para un lote físico confirmado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loteId": { "type": "string" },
        "fechaEmision": { "type": "string" }
      },
      "required": ["id", "loteId", "fechaEmision"]
    },
    "Silo": {
      "title": "Silo",
      "description": "Silos físicos fijos de la planta (6 silos)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" }
      },
      "required": ["id", "nombre"]
    },
    "Precarga": {
      "title": "Precarga",
      "description": "Registro de precargas proyectadas desde silos",
      "type": "object",
      "properties": {
        "siloId": { "type": "string" },
        "kgTomados": { "type": "number" },
        "mermaPct": { "type": "number" },
        "kgNetos": { "type": "number" },
        "envase": { "type": "string" },
        "cantidadBolsas": { "type": "number" },
        "cantidadLotes": { "type": "number" }
      },
      "required": ["siloId", "kgTomados", "mermaPct", "kgNetos", "envase", "cantidadBolsas", "cantidadLotes"]
    }
  },
  "firestore": {
    "/lotes/{loteId}": {
      "schema": "Lote",
      "description": "Colección de lotes de granos"
    },
    "/silos_estado/{docId}": {
      "schema": "SilosEstado",
      "description": "Estado manual de silos (Ocupado, Vacío Sucio, Vacío Limpio)"
    },
    "/movimientos_silo/{movId}": {
      "schema": "MovimientoSilo",
      "description": "Movimientos de ingreso y egreso de silos"
    },
    "/bolsones_campo/{bolsonId}": {
      "schema": "BolsonCampo",
      "description": "Colección de silobolsas y lotes en campo con datos agronómicos y GIS"
    },
    "/configuracion_planta/{docId}": {
      "schema": "PlantaCatalogos",
      "description": "Catálogos maestros y filtros de planta"
    },
    "/turnosParking/{turnoId}": {
      "schema": "TurnoParking",
      "description": "Colección de turnos y precargas de Parking"
    },
    "/config/{docId}": {
      "schema": "ParkingConfig",
      "description": "Configuraciones globales del sistema (ej: config/parking)"
    },
    "/movimientos/{movId}": {
      "schema": "Movimiento",
      "description": "Historial de movimientos y trazabilidad de lotes"
    },
    "/reportes_diarios/{repId}": {
      "schema": "ReporteDiario",
      "description": "Reportes diarios de producción y curado"
    },
    "/bolsas/{bolsaId}": {
      "schema": "Bolsa",
      "description": "Identificaciones de bolsa unitaria con QR"
    },
    "/caratulas/{caratulaId}": {
      "schema": "Caratula",
      "description": "Carátulas físicas emitidas para lotes"
    },
    "/silos/{siloId}": {
      "schema": "Silo",
      "description": "Registro maestro de los 6 silos físicos"
    },
    "/precargas/{precargaId}": {
      "schema": "Precarga",
      "description": "Proyecciones de precarga"
    }
  }
}
